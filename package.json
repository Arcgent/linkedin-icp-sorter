{
  "name": "linkedin-icp-sorter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sort your LinkedIn connections into Warm / Maybe warm / Cold / Not relevant with TypeSafe Jev, then find who has a reason to talk now and draft the first message.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-records.mjs",
    "engagement": "node --env-file-if-exists=.env scripts/fetch-engagement.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "one": "node --env-file-if-exists=.env cli.mjs one",
    "run": "node --env-file-if-exists=.env cli.mjs run",
    "bench": "node --env-file-if-exists=.env cli.mjs bench",
    "signals": "node --env-file-if-exists=.env cli.mjs signals",
    "openers": "node --env-file-if-exists=.env cli.mjs openers"
  },
  "engines": {
    "node": ">=22"
  }
}
