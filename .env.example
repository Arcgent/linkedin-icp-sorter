# Copy to .env and fill in. .env is ignored by git.

# Required: Jev runs through OpenRouter. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: pin a Jev version instead of the latest (default ~typesafe/jev-latest)
# JEV_MODEL=~typesafe/jev-latest

# Optional: call TypeSafe directly instead of OpenRouter
# JEV_DIRECT=1
# TYPESAFE_API_KEY=

# Optional: port for the local app (default 3161)
# PORT=3161

# Step 4 (Reach out) needs ONE signal provider. Unipile also powers `npm run engagement`.
# Unipile: reads LinkedIn through your own connected account (keep it to 100-150 people a day)
# UNIPILE_DSN=apiXXX.unipile.com:13443
# UNIPILE_API_KEY=
# UNIPILE_ACCOUNT_ID=
# Apify: no LinkedIn login, pay per result
# APIFY_TOKEN=
# Force one when both are set: unipile | apify
# SIGNALS_PROVIDER=

# Optional: model and language for the openers (default anthropic/claude-sonnet-5.5, language auto)
# OPENER_MODEL=anthropic/claude-sonnet-5.5
# OPENER_LANGUAGE=auto
