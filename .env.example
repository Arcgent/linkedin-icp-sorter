# Copy to .env and fill in. .env is ignored by git.

# Required: Jev runs through OpenRouter. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: pin a Jev version instead of the latest (default ~typesafe/jev-latest)
# JEV_MODEL=~typesafe/jev-latest

# Optional: call TypeSafe directly instead of OpenRouter
# JEV_DIRECT=1
# TYPESAFE_API_KEY=

# Optional: port for the local app (default 3161)
# PORT=3161

# Optional: only for `npm run engagement` (who reacted to or commented on your posts)
# UNIPILE_DSN=apiXXX.unipile.com:13443
# UNIPILE_API_KEY=
# UNIPILE_ACCOUNT_ID=
